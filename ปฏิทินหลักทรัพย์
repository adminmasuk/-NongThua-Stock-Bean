<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>น้องถั่ว ถัวหุ้น</title>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Prompt',sans-serif;background:#e3ede8;min-height:100vh;color:#4a3520;overflow-x:hidden;} .page,.app-wrap{width:100%;max-width:480px;margin:0 auto;position:relative;}
.header{background:linear-gradient(90deg,#2d7a3a,#5a9e3a);padding:12px 18px;display:flex;align-items:center;gap:20px;justify-content:flex-start;position:sticky;top:0;z-index:50;box-shadow:0 2px 12px rgba(0,0,0,0.15);width:100%;}

/* ── Header ── */
.app-wrap{width:100%;max-width:480px;margin:0 auto;position:relative;}
.header{background:linear-gradient(90deg,#2d7a3a,#5a9e3a);padding:12px 18px;display:flex;align-items:center;gap:20px;justify-content:flex-start;position:sticky;top:0;z-index:50;box-shadow:0 2px 12px rgba(0,0,0,0.15);width:100%;}
.header-left{display:flex;align-items:center;gap:10px;}
.header-bean{width:44px;height:44px;object-fit:contain;}
.header-info small{color:#c8f0c0;font-size:10px;letter-spacing:2px;display:block;}
.header-info strong{color:#fff;font-size:16px;font-weight:700;}
.hamburger{width:36px;height:36px;background:rgba(255,255,255,0.15);border:none;border-radius:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;position:relative;z-index:60;pointer-events:all;flex-shrink:0;}

/* ── Mobile Menu ── */
.menu-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.3);z-index:100;display:none;width:100vw;max-width:100vw;}
.menu-overlay.show{display:block;}
.menu-panel{position:fixed;top:0;left:0;width:240px;height:100%;background:#fff;z-index:101;padding:20px;box-shadow:4px 0 20px rgba(0,0,0,0.15);transform:translateX(-100%);transition:transform 0.25s ease;max-width:240px;}
.menu-panel.show{transform:translateX(0);}
.menu-close{float:right;background:none;border:none;font-size:20px;cursor:pointer;color:#888;margin-bottom:16px;}
.menu-item{display:flex;align-items:center;gap:12px;padding:14px 12px;border-radius:12px;cursor:pointer;font-size:15px;font-weight:500;color:#4a3520;margin-bottom:4px;}
.menu-item:hover{background:#e8f5e0;color:#2d7a3a;}.menu-item.active{background:#d5f0d0;color:#1a5c28;font-weight:600;}.menu-item.active img{filter:brightness(0) saturate(100%) invert(20%) sepia(80%) saturate(600%) hue-rotate(100deg);}
.menu-item i{font-size:20px;} .menu-svg-icon{width:20px;height:20px;}

/* ── Pages ── */
.page{display:none;padding-bottom:24px;width:100%;min-height:0;height:0;overflow:hidden;}
.page.active{display:block;background:#e3ede8;width:100%;height:auto;overflow:visible;min-height:calc(100vh - 68px);}

/* ── Home Page ── */
.hero-card{margin:16px;background:linear-gradient(135deg,#ffffff,#f6faf3);border:1px solid #eef6ea;border-radius:24px;padding:20px 22px;box-shadow:0 8px 24px rgba(45,122,58,0.10);display:flex;align-items:center;gap:14px;}
.hero-bean{width:80px;height:80px;object-fit:contain;}
.hero-badge{background:#e8f5e0;color:#2d7a3a;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;letter-spacing:1px;margin-bottom:6px;display:inline-block;}
.hero-title{font-size:20px;font-weight:700;color:#1a1a1a;margin-bottom:4px;}
.hero-desc{font-size:13px;color:#555555;line-height:1.6;}

.section-label{padding:4px 20px 8px;font-size:13px;color:#555555;font-weight:600;}
.plan-active-badge{background:#e8f5e0;color:#2d7a3a;font-size:11px;padding:2px 10px;border-radius:99px;font-weight:600;}

/* Plan cards */
.plans-scroll{display:flex;overflow-x:auto;gap:14px;padding:6px 16px 12px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;}
.plans-scroll::-webkit-scrollbar{display:none;}
.plan-card{min-width:260px;background:#fff;border:1px solid #f3f3f3;border-radius:20px;padding:20px;box-shadow:0 4px 16px rgba(45,122,58,0.08);position:relative;scroll-snap-align:start;flex-shrink:0;}
.plan-card.pro{border:2px solid #2d7a3a;background:linear-gradient(180deg,#ffffff,#f6faf3);box-shadow:0 8px 24px rgba(45,122,58,0.18);}
.pro-badge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#2d7a3a;color:#fff;font-size:11px;font-weight:700;padding:3px 16px;border-radius:99px;}
.plan-icon{width:36px;height:36px;border-radius:10px;background:#f0f7e6;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px;}
.plan-name{font-size:12px;color:#888;font-weight:500;margin-bottom:2px;}
.plan-price{font-size:28px;font-weight:700;color:#1a1a1a;}
.plan-price span{font-size:13px;color:#888;font-weight:400;}
.plan-desc{font-size:12px;color:#555555;margin:4px 0 8px;}
.plan-tag{display:inline-block;font-size:11px;padding:2px 10px;border-radius:99px;font-weight:600;margin-bottom:12px;}
.tag-green{background:#e8f5e0;color:#2d7a3a;}
.tag-blue{background:#e8f0ff;color:#3455d4;}
.plan-divider{border:none;border-top:1px solid #f0e8d8;margin:10px 0;}
.plan-feature{display:flex;align-items:center;gap:8px;font-size:13px;color:#333333;margin-bottom:8px;}
.plan-feature i{font-size:16px;}
.feat-check{color:#2d7a3a;}
.feat-plus{color:#3455d4;}
.plan-btn{display:block;width:100%;margin-top:14px;padding:12px;border-radius:14px;font-size:14px;font-weight:600;font-family:'Prompt',sans-serif;cursor:pointer;text-align:center;border:none;transition:transform 0.15s ease;}
.plan-btn:active{transform:scale(0.97);}
.btn-active{background:#e8f5e0;color:#2d7a3a;}
.btn-pro{background:linear-gradient(135deg,#2d7a3a,#4CAF50);color:#fff;box-shadow:0 4px 12px rgba(45,122,58,0.3);}

/* Profile + Credit Summary card */
.profile-credit-card{margin:16px;background:linear-gradient(135deg,#1a5c28,#2d7a3a);border-radius:24px;padding:20px 22px;box-shadow:0 8px 24px rgba(26,92,40,0.25);}
.profile-row{display:flex;align-items:center;gap:12px;}
.profile-avatar{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.profile-info{flex:1;min-width:0;}
.profile-name-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.profile-name{font-size:16px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;}
.profile-tier-badge{background:rgba(255,255,255,0.92);color:#1a5c28;font-size:10px;font-weight:700;padding:2px 9px;border-radius:99px;letter-spacing:0.5px;flex-shrink:0;}
.profile-sub{font-size:12px;color:rgba(255,255,255,0.9);margin-top:2px;}
.profile-bell{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,0.15);border:none;color:#fff;font-size:18px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
.profile-divider{height:1px;background:rgba(255,255,255,0.18);margin:16px 0;}
.credit-label{font-size:13px;font-weight:600;color:rgba(255,255,255,0.95);}
.credit-reset{font-size:11px;color:rgba(255,255,255,0.8);}
.credit-number{font-size:30px;font-weight:700;color:#fff;line-height:1.2;margin-bottom:8px;}
#credit-remaining-text{color:#FFF176;}
.credit-number-total{font-size:14px;font-weight:500;color:rgba(255,255,255,0.8);}
.credit-track{background:rgba(255,255,255,0.22);height:8px;border-radius:99px;overflow:hidden;}
.credit-fill{background:#FFF176;height:100%;border-radius:99px;transition:width 0.3s ease;}
.credit-used-text{font-size:12px;color:rgba(255,255,255,0.8);margin-top:8px;}

/* Banner */
.banner-card{margin:12px 16px;border-radius:20px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.08);line-height:0;}
.banner-card img{width:100%;height:auto;display:block;}

/* Promo card */
.promo-card{margin:12px 16px;background:#fff8e1;border:1px solid #ffe082;border-radius:20px;padding:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 4px 16px rgba(0,0,0,0.06);}
.promo-eyebrow{font-size:12px;font-weight:700;color:#7a4a00;margin-bottom:4px;}
.promo-title{font-size:19px;font-weight:700;color:#1a1a1a;margin-bottom:4px;}
.promo-desc{font-size:13px;color:#555555;margin-bottom:14px;}
.promo-btn{background:linear-gradient(135deg,#2d7a3a,#4CAF50);color:#fff;border:none;border-radius:12px;padding:12px 20px;min-height:44px;font-size:14px;font-weight:600;font-family:'Prompt',sans-serif;cursor:pointer;box-shadow:0 4px 12px rgba(45,122,58,0.3);}
.promo-icon{font-size:56px;flex-shrink:0;line-height:1;}

/* Section header */
.section-header-row{padding:16px 20px 4px;}
.section-subtext{font-size:12px;color:#555555;margin-top:2px;}
.sample-badge{background:#fff3cd;color:#7a4a00;font-size:10px;font-weight:700;padding:2px 8px;border-radius:99px;}
.section-more{display:flex;align-items:center;gap:1px;font-size:12px;font-weight:600;color:#2d7a3a;cursor:pointer;flex-shrink:0;white-space:nowrap;}
.section-more-icon{font-size:16px;line-height:1;}

/* XD Calendar */
.xd-tabs{display:flex;gap:8px;padding:10px 16px;overflow-x:auto;}
.xd-tab{flex-shrink:0;padding:8px 16px;min-height:36px;border-radius:99px;border:1.5px solid #e0e0e0;background:#fff;color:#555555;font-size:13px;font-weight:600;font-family:'Prompt',sans-serif;cursor:pointer;}
.xd-tab.active{background:#1a5c28;border-color:#1a5c28;color:#fff;}
.xd-list{display:flex;flex-direction:column;gap:10px;padding:0 16px;}
.xd-pager{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.xd-pager::-webkit-scrollbar{display:none;}
.xd-page{flex:0 0 100%;scroll-snap-align:start;min-width:0;}
.xd-dots{display:flex;justify-content:center;align-items:center;gap:6px;padding:10px 0 2px;}
.xd-dot{width:6px;height:6px;border-radius:50%;background:#d8d4c4;border:none;padding:0;cursor:pointer;transition:width .2s ease,background-color .2s ease,border-radius .2s ease;}
.xd-dot.active{width:18px;border-radius:3px;background:#2d7a3a;}
.xd-item-wrap{background:#fff;border:1px solid #f0f0f0;border-radius:16px;box-shadow:0 2px 8px rgba(0,0,0,0.04);overflow:hidden;}
.xd-item{display:flex;align-items:center;gap:12px;padding:14px;cursor:pointer;}
.xd-item:active{background:#fafaf7;}
.xd-chevron{color:#c0c0c0;font-size:18px;flex-shrink:0;transition:transform 0.2s ease;}
.xd-chevron.open{transform:rotate(90deg);color:#2d7a3a;}
.xd-detail-panel{display:none;padding:14px 14px 16px;border-top:1px solid #f0f0f0;background:#fbfbf8;}
.xd-detail-panel.open{display:block;}
.xd-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px;}
.xd-detail-label{font-size:12px;color:#8a8a8a;margin-bottom:4px;}
.xd-detail-value{font-size:14px;font-weight:700;color:#1a1a1a;}
.xd-detail-note{padding-top:12px;margin-top:12px;border-top:1px dashed #e0dcd0;font-size:11px;color:#7a6040;}
.xd-detail-value.green{color:#1a5c28;}
.xd-date{width:44px;text-align:center;background:#e8f5e9;border-radius:10px;padding:6px 4px;flex-shrink:0;}
.xd-day{display:block;font-size:16px;font-weight:700;color:#1a5c28;}
.xd-month{display:block;font-size:10px;color:#1a5c28;}
.xd-info{flex:1;min-width:0;}
.xd-name{font-size:14px;font-weight:600;color:#1a1a1a;display:flex;align-items:center;gap:6px;}
.xd-tag{background:#e8f0ff;color:#1a3aad;font-size:10px;font-weight:700;padding:1px 7px;border-radius:99px;}
.xd-detail{font-size:12px;color:#555555;margin-top:2px;}
.xd-yield{font-size:14px;font-weight:700;color:#1a5c28;text-align:right;flex-shrink:0;}
.xd-yield span{display:block;font-size:10px;font-weight:500;color:#555555;}
.xd-empty{padding:24px;text-align:center;font-size:13px;color:#555555;}
.xd-disclaimer{padding:8px 16px 4px;font-size:11px;color:#8a8a8a;}

/* Plans v2 (stacked) */
.plans-stack{display:flex;flex-direction:column;gap:12px;padding:8px 16px 4px;}
.plan-card-v2{background:#fff;border:1.5px solid #eee;border-radius:20px;padding:18px 20px;}
.plan-card-v2.current{border-color:#2d7a3a;}
.plan-card-v2.pro{border-color:#2d7a3a;box-shadow:0 8px 24px rgba(45,122,58,0.14);}
.plan-card-v2-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2px;}
.plan-card-v2-name{font-size:18px;font-weight:700;color:#1a1a1a;margin-right:8px;}
.plan-card-v2-badge{font-size:11px;font-weight:700;padding:2px 10px;border-radius:99px;}
.current-badge{background:#e8f5e9;color:#1a5c28;}
.pro-badge-v2{background:#fff3cd;color:#7a4a00;}
.plan-card-v2-price{font-size:18px;font-weight:700;color:#1a1a1a;text-align:right;}
.plan-card-v2-price span{display:block;font-size:11px;font-weight:500;color:#555555;}
.plan-card-v2-sub{font-size:12px;color:#555555;margin:2px 0 12px;}
.plan-card-v2-feature{font-size:13px;color:#333333;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
.plan-card-v2-btn{display:block;width:100%;margin-top:10px;padding:13px;min-height:44px;border-radius:12px;font-size:14px;font-weight:600;font-family:'Prompt',sans-serif;cursor:pointer;text-align:center;border:none;background:#f0f0f0;color:#999;}
.plan-card-v2-btn.disabled{cursor:not-allowed;}
.plan-card-v2.pro .plan-card-v2-btn{background:linear-gradient(135deg,#2d7a3a,#4CAF50);color:#fff;box-shadow:0 4px 12px rgba(45,122,58,0.3);cursor:pointer;}
.plan-card-v2.pro .plan-card-v2-btn.disabled{background:#f0f0f0;color:#999;box-shadow:none;cursor:not-allowed;}

/* Tip card */

/* Contact */
.contact-section{margin:16px;background:linear-gradient(135deg,#1a5c28,#2d7a3a);border-radius:24px;padding:16px 4px 14px;box-shadow:0 8px 24px rgba(26,92,40,0.25);}
.contact-label{padding:8px 20px 6px;font-size:13px;color:#ffffff;font-weight:600;}
.contact-card{margin:6px 16px;background:#fff;border:1px solid #f3f3f3;border-radius:16px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 8px rgba(0,0,0,0.05);text-decoration:none;color:inherit;transition:transform 0.15s ease;}
.contact-card:active{transform:scale(0.98);}
.contact-stack{display:flex;flex-direction:column;gap:2px;}
.contact-stack .contact-card{margin:4px 16px;}
.contact-mock-note{padding:6px 20px 4px;font-size:11px;color:#eef7ef;}
.contact-left{display:flex;align-items:center;gap:12px;}
.contact-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;}
.icon-green{background:#e8f5e0;color:#2d7a3a;}
.icon-red{background:#fee8e8;color:#d43434;}
.contact-name{font-size:11px;color:#888;font-weight:500;letter-spacing:1px;}
.contact-val{font-size:13px;font-weight:600;color:#1a1a1a;}
.contact-arrow{color:#c8c8c8;font-size:20px;flex-shrink:0;}

/* ── Form Pages ── */
.page-title{padding:20px 20px 12px;display:flex;align-items:center;gap:14px;}
.page-title-icon{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#2d7a3a,#6ab04c);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;}
.page-title-text h2{font-size:22px;font-weight:700;color:#3a2800;}
.page-title-text p{font-size:13px;color:#9a8060;margin-top:2px;}

.form-card{background:#fff;margin:0 16px 16px;border-radius:24px;padding:22px;box-shadow:0 4px 16px rgba(0,0,0,0.06);}
.form-section-label{font-size:12px;color:#9a8060;font-weight:600;margin-bottom:14px;letter-spacing:0.5px;}

.field{margin-bottom:18px;}
.field:last-child{margin-bottom:0;}
.field-label{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:#5c3b24;margin-bottom:8px;}
.field-label i{font-size:16px;color:#8c6040;}
.input-wrap{position:relative;}
.input-wrap input{width:100%;height:40px;max-height:40px;border:1.5px solid #CCCCCC;outline:none;border-radius:999px;padding:0 20px;background:#FCFCFC;font-size:16px;font-weight:500;color:#3a2800;font-family:'Prompt',sans-serif;transition:border 0.2s;}
.input-wrap input:focus{background:#FCFCFC;border:2px solid #1a5c28;outline:none;}
.input-wrap input.error{background:#fdecea;outline:2px solid #e53935;}
.input-wrap input::placeholder{color:#CCCCCC;}
.input-wrap input.has-unit{padding-right:52px;}
.input-wrap textarea{width:100%;min-height:80px;border:1.5px solid #CCCCCC;outline:none;border-radius:20px;padding:16px 24px;background:#FCFCFC;font-size:16px;font-weight:500;color:#3a2800;font-family:'Prompt',sans-serif;transition:border 0.2s;resize:none;}
.input-wrap textarea:focus{background:#FCFCFC;border:2px solid #1a5c28;outline:none;}
.input-wrap textarea::placeholder{color:#CCCCCC;}
.unit{position:absolute;right:22px;top:50%;transform:translateY(-50%);font-size:14px;color:#9a8060;font-weight:600;pointer-events:none;}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.err-msg{font-size:11px;color:#e53935;margin-top:4px;padding-left:12px;display:none;}

.calc-btn{display:block;width:calc(100% - 32px);margin:0 16px 16px;padding:18px;background:linear-gradient(90deg,#3d8a3d,#6ab04c);color:#fff;border:none;border-radius:999px;font-size:18px;font-weight:700;font-family:'Prompt',sans-serif;cursor:pointer;box-shadow:0 6px 20px rgba(61,138,61,0.3);}
.calc-btn:active{transform:scale(0.98);}



/* ── Modal ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);display:none;align-items:center;justify-content:center;z-index:200;padding:20px;}
.modal-overlay.show{display:flex;}
.modal{width:90%;max-width:430px;background:#f8f4ee;border-radius:20px;overflow:hidden;animation:fadeInModal 0.22s ease;max-height:88vh;overflow-y:auto;}
@keyframes fadeInModal{from{opacity:0;transform:scale(0.93);}to{opacity:1;transform:scale(1);}}
.modal-header{background:linear-gradient(90deg,#2d7a3a,#5a9e3a);padding:14px 18px;display:flex;align-items:center;gap:12px;position:relative;}
.modal-logo{width:34px;height:34px;background:#f5c842;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;}
.modal-header-text small{color:#c8f0c0;font-size:10px;display:block;}
.modal-header-text strong{color:#fff;font-size:15px;font-weight:700;}
.modal-close{position:absolute;right:14px;top:50%;transform:translateY(-50%);width:30px;height:30px;background:rgba(255,255,255,0.2);border:none;border-radius:50%;color:#fff;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;}

.modal-cards{padding:12px 14px;display:flex;flex-direction:column;gap:9px;}
.cs{border-radius:14px;padding:11px 13px;}
.cs-info{background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:1px solid #c8e6c9;}
.cs-price{background:#fff;border:1px solid #e8e0d0;}
.cs-qty{background:#fff;border:1px solid #e8e0d0;}
.cs-money{background:linear-gradient(135deg,#fff8e1,#fffde7);border:1px solid #ffe082;}
.cs-div{background:#fff;border:1px solid #e8e0d0;}
.cs-note{background:#f9f9f9;border:1px dashed #d0c8b8;}
.cs-footer{background:linear-gradient(135deg,#f0f7e6,#e8f5e9);border:1px solid #c8e6c9;text-align:center;padding:8px 12px;}
.cs-row{display:flex;justify-content:space-between;align-items:center;padding:3px 0;}
.cs-row+.cs-row{border-top:1px solid rgba(0,0,0,0.06);margin-top:5px;padding-top:6px;}
.cs-label{font-size:12px;color:#7a6040;font-weight:500;}
.cs-val{font-size:13px;font-weight:700;color:#3a2800;text-align:right;}
.cs-val.green{color:#2d7a3a;}
.cs-val.orange{color:#e07800;}
.cs-val.red{color:#d43434;}
.cs-val.big{font-size:17px;}
.cs-title{font-size:10px;font-weight:700;color:#9a8060;letter-spacing:0.5px;margin-bottom:7px;text-transform:uppercase;}
.cs-footer-txt{font-size:11px;color:#5a7a40;font-weight:600;}

.modal-actions{padding:0 14px 18px;display:grid;grid-template-columns:1fr;gap:10px;}
.btn-save{padding:14px;background:#2d7a3a;color:#fff;border:none;border-radius:16px;font-size:15px;font-weight:700;font-family:'Prompt',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;}

.disclaimer{background:#fff8e8;border-radius:10px;padding:10px 14px;margin:0 14px 8px;font-size:11px;color:#9a7040;line-height:1.5;}
.input-wrap textarea{width:100%;min-height:70px;border:1.5px solid #CCCCCC;outline:none;border-radius:18px;padding:14px 20px;background:#FCFCFC;font-size:15px;font-weight:500;color:#3a2800;font-family:'Prompt',sans-serif;transition:border 0.2s;resize:none;box-sizing:border-box;}
.input-wrap textarea:focus{border:2px solid #1a5c28;outline:none;}
.input-wrap textarea::placeholder{color:#CCCCCC;}
.input-ticker{text-transform:uppercase;}
/* ── Trade Page ── */
.trade-tabs{display:flex;gap:8px;margin-bottom:20px;}
.trade-tab{flex:1;padding:10px;border-radius:12px;border:2px solid #ccc;background:#fff;font-size:15px;font-weight:700;font-family:'Prompt',sans-serif;cursor:pointer;color:#2d7a3a;transition:all 0.2s;text-align:center;user-select:none;-webkit-tap-highlight-color:transparent;pointer-events:all;}
.trade-tab.active-buy{background:#2d7a3a;border-color:#2d7a3a;color:#fff;}
.trade-tab.active-sell{background:#2d7a3a;border-color:#2d7a3a;color:#fff;}
.trade-result-box{background:linear-gradient(135deg,#f0f7e6,#e8f5e9);border:1px solid #c8e6c9;border-radius:14px;padding:12px 16px;margin-top:4px;}
.trade-result-row{display:flex;justify-content:space-between;align-items:center;padding:3px 0;}
.trade-result-label{font-size:12px;color:#7a6040;}
.trade-result-val{font-size:15px;font-weight:700;color:#2d7a3a;}
.trade-result-val.orange{color:#e07800;}
.trade-result-val.red{color:#d43434;}
